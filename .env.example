# Copy to .env and fill in before running `docker compose up`

POSTGRES_DB=giis_canteen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Use a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# First admin account, created on startup if it doesn't exist. Leave the password empty to skip.
ADMIN_LOGIN_ID=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=5432
